{
	"name": "n8n-nodes-wayvz",
	"version": "0.1.0",
	"description": "n8n community node for the WAYVZ SMS API: send SMS, track delivery, manage bulks and verify phone numbers with one-time codes.",
	"license": "MIT",
	"homepage": "https://api.wayvzgroup.com/docs",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"wayvz",
		"sms",
		"otp",
		"verify"
	],
	"author": {
		"name": "Hussein Fares",
		"email": "hfares@wayvzgroup.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wayvzgroup/n8n-nodes-wayvz.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test \"test/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WayvzApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Wayvz/Wayvz.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.58.7",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
